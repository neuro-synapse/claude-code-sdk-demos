# Anthropic API Key (Required for all modes)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# E2B API Key (Required for Durable Mode)
# Get your key at: https://e2b.dev/dashboard
E2B_API_KEY=e2b_your-key-here

# PostgreSQL Database URL (Required for DBOS Durable Workflows)
# Format: postgresql://user:password@host:port/database
# Example local: postgresql://dbos:dbos@localhost:5432/research_agent
# Example Docker: postgresql://dbos:dbos@localhost:5432/research_agent
DATABASE_URL=postgresql://user:password@localhost:5432/research_agent
